{
  "hosting": [
    {
      "site": "kflsagnd", 
      "public": "dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "/b/**",
          "destination": "/booking.html"
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
